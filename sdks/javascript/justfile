# JavaScript SDK workflows.

# List available recipes.
default:
    @just --list

# Build dist through the local Compose stack.
build:
    docker compose run --rm build

# Check the SDK through the local Compose stack.
test:
    docker compose run --rm test

# Publish an exact SDK revision. With no arguments, use the package version and
# its v-prefixed release tag. An explicit revision supports exceptional
# package-only corrections without moving the product release tag.
[doc("Publish the SDK from an exact Git revision to npm.")]
publish version='' source_ref='':
    #!/usr/bin/env bash
    set -euo pipefail

    requested_version={{quote(version)}}
    if [[ -z "$requested_version" ]]; then
      requested_version=$(bun -p "require('./package.json').version")
    fi

    repository=$(git rev-parse --show-toplevel)
    source_ref={{quote(source_ref)}}
    require_remote_tag=false
    if [[ -z "$source_ref" ]]; then
      source_ref="v${requested_version}"
      require_remote_tag=true
    elif git -C "$repository" show-ref --verify --quiet "refs/tags/${source_ref}"; then
      require_remote_tag=true
    fi

    if [[ -n "$(git -C "$repository" status --porcelain --untracked-files=all)" ]]; then
      echo "Refusing to publish from a dirty worktree." >&2
      git -C "$repository" status --short >&2
      exit 1
    fi

    branch=$(git -C "$repository" branch --show-current)
    if [[ "$branch" != main ]]; then
      echo "Refusing to publish from '$branch'; releases are published from main." >&2
      exit 1
    fi

    git -C "$repository" fetch --quiet origin
    head_commit=$(git -C "$repository" rev-parse HEAD)
    remote_main=$(git -C "$repository" rev-parse origin/main)
    if [[ "$head_commit" != "$remote_main" ]]; then
      echo "Refusing to publish: main is not synchronized with origin/main." >&2
      exit 1
    fi

    if [[ "$require_remote_tag" == true ]]; then
      tag_ref="refs/tags/${source_ref}"
      local_tag=$(git -C "$repository" rev-parse --verify "$tag_ref")
      remote_tag=$(git -C "$repository" ls-remote --refs origin "$tag_ref" | awk 'NR == 1 { print $1 }')
      if [[ -z "$remote_tag" ]]; then
        echo "Refusing to publish: tag $source_ref is not on origin." >&2
        exit 1
      fi
      if [[ "$local_tag" != "$remote_tag" ]]; then
        echo "Refusing to publish: local and origin tags for $source_ref differ." >&2
        exit 1
      fi
    fi

    source_commit=$(git -C "$repository" rev-parse --verify "${source_ref}^{commit}" 2>/dev/null) || {
      echo "Refusing to publish: Git revision $source_ref does not exist." >&2
      exit 1
    }
    if ! git -C "$repository" merge-base --is-ancestor "$source_commit" origin/main; then
      echo "Refusing to publish: $source_ref is not reachable from origin/main." >&2
      exit 1
    fi

    release_root=$(mktemp -d)
    trap 'rm -rf "$release_root"' EXIT
    git -C "$repository" archive "$source_commit" sdks/javascript | tar -x -C "$release_root"
    release_sdk="$release_root/sdks/javascript"
    cd "$release_sdk"

    package_name=$(bun -p "require('./package.json').name")
    tagged_version=$(bun -p "require('./package.json').version")
    if [[ "$tagged_version" != "$requested_version" ]]; then
      echo "Refusing to publish: $source_ref contains $package_name@$tagged_version, not $requested_version." >&2
      exit 1
    fi

    published_version=$(npm view "$package_name@$requested_version" version 2>/dev/null || true)
    if [[ "$published_version" == "$requested_version" ]]; then
      echo "$package_name@$requested_version is already on npm, skipping"
      exit 0
    fi

    bun install --frozen-lockfile
    bun run test
    bun run typecheck
    npm publish --dry-run --access public

    printf '\nPublish %s@%s from %s to npm? [y/N] ' "$package_name" "$requested_version" "$source_ref"
    read -r reply
    case "$reply" in
      [yY]|[yY][eE][sS]) ;;
      *) echo "Aborted."; exit 1 ;;
    esac

    npm publish --access public
