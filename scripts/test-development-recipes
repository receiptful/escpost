#!/bin/sh

set -eu

repository=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository"

docker_web=$(just --dry-run docker-web-dev 2>&1)
native_web=$(just --dry-run native-web-dev 2>&1)

printf '%s\n' "$docker_web" | rg -F "docker compose up cli frontend" >/dev/null
printf '%s\n' "$native_web" | rg -F "scripts/native-web-dev" >/dev/null
