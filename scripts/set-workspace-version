#!/usr/bin/env python3

import json
import os
import re
import stat
import sys
import tempfile
import tomllib
from pathlib import Path


VERSION = re.compile(r"^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$")
DEPENDENCIES = ("escpost-profiles", "escpost-render")
WORKSPACE_PACKAGES = ("escpost", "escpost-profiles", "escpost-python", "escpost-render")
PACKAGE_MANIFESTS = (
    (Path("sdks/javascript/package.json"), "@receiptful/escpost"),
    (Path("browser-extension/package.json"), "escpost-browser-extension"),
)


def replace_once(text: str, pattern: str, version: str, description: str) -> str:
    matches = list(re.finditer(pattern, text, flags=re.MULTILINE))
    if len(matches) != 1:
        raise ValueError(f"expected one {description}, found {len(matches)}")
    return re.sub(
        pattern,
        lambda match: f'{match.group(1)}{version}{match.group(2)}',
        text,
        count=1,
        flags=re.MULTILINE,
    )


def updated_manifest(text: str, version: str) -> str:
    manifest = tomllib.loads(text)
    workspace = manifest.get("workspace", {})
    package = workspace.get("package", {})
    dependencies = workspace.get("dependencies", {})
    if "version" not in package:
        raise ValueError("workspace.package.version is missing")
    for dependency in DEPENDENCIES:
        specification = dependencies.get(dependency)
        if not isinstance(specification, dict) or "version" not in specification:
            raise ValueError(f"workspace dependency {dependency} has no version")

    text = replace_once(
        text,
        r'^(version\s*=\s*")[^"]+("\s*)$',
        version,
        "workspace package version",
    )
    for dependency in DEPENDENCIES:
        text = replace_once(
            text,
            rf'^({re.escape(dependency)}\s*=\s*\{{[^}}\n]*\bversion\s*=\s*")[^"]+("[^}}\n]*\}}\s*)$',
            version,
            f"{dependency} version requirement",
        )
    tomllib.loads(text)
    return text


def updated_package_manifest(text: str, version: str, expected_name: str) -> str:
    manifest = json.loads(text)
    if manifest.get("name") != expected_name:
        raise ValueError(f"expected package name {expected_name!r}")
    current_version = manifest.get("version")
    if not isinstance(current_version, str) or VERSION.fullmatch(current_version) is None:
        raise ValueError(f"{expected_name} has no semantic version")
    return replace_once(
        text,
        r'^(\s*"version"\s*:\s*")[^"]+(",?\s*)$',
        version,
        f"{expected_name} package version",
    )


def updated_lockfile(text: str, version: str) -> str:
    lockfile = tomllib.loads(text)
    packages = lockfile.get("package", [])
    for package_name in WORKSPACE_PACKAGES:
        matching = [package for package in packages if package.get("name") == package_name]
        if len(matching) != 1:
            raise ValueError(f"expected one {package_name} lockfile package, found {len(matching)}")
        current_version = matching[0].get("version")
        if not isinstance(current_version, str) or VERSION.fullmatch(current_version) is None:
            raise ValueError(f"{package_name} has no semantic lockfile version")
        text = replace_once(
            text,
            rf'^(\[\[package\]\]\nname = "{re.escape(package_name)}"\nversion = ")[^"]+(")',
            version,
            f"{package_name} lockfile version",
        )
    return text


def release_updates(repository: Path, version: str) -> list[tuple[Path, str]]:
    cargo_manifest = repository / "Cargo.toml"
    cargo_lockfile = repository / "Cargo.lock"
    updates = [
        (cargo_manifest, updated_manifest(cargo_manifest.read_text(), version)),
        (cargo_lockfile, updated_lockfile(cargo_lockfile.read_text(), version)),
    ]
    for relative_path, expected_name in PACKAGE_MANIFESTS:
        path = repository / relative_path
        updates.append((path, updated_package_manifest(path.read_text(), version, expected_name)))
    return updates


def write_atomically(path: Path, text: str) -> None:
    mode = stat.S_IMODE(path.stat().st_mode)
    descriptor, temporary_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(descriptor, "w") as temporary:
            temporary.write(text)
        os.chmod(temporary_name, mode)
        os.replace(temporary_name, path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    if len(sys.argv) != 2 or VERSION.fullmatch(sys.argv[1]) is None:
        print("usage: set-workspace-version <major.minor.patch>", file=sys.stderr)
        return 2

    repository = Path(__file__).resolve().parent.parent
    try:
        updates = release_updates(repository, sys.argv[1])
        for path, text in updates:
            write_atomically(path, text)
    except (OSError, ValueError, tomllib.TOMLDecodeError) as error:
        print(f"could not set release version: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
