set default-list

# Start/resume the desktop; --usb opens a picker, or repeat --usb DEVICE for several devices.
[positional-arguments]
[working-directory: invocation_directory()]
start *args:
    "{{justfile_directory()}}/packaging/windows/tester/run" start "$@"

# List Linux host USB devices and their identifiers, without starting Windows.
usb-list:
    ./run usb-list

# Stop without discarding the Windows session's disk.
stop:
    ./run stop

# Inspect the tester VM.
status:
    ./run status

# Discard the stopped tester's changes and restore clean Windows.
reset:
    ./run reset
